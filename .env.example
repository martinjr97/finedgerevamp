APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_EMAIL_DOMAIN=havencrest.co.zm
WEBSITE_URL=
SYSTEM_LOGO_PATH=img/logo.png
FAVICON_PATH=img/favicon_io/favicon.ico

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Testing uses a separate database (see .env.testing and phpunit.xml).
# Never point tests at your development database — RefreshDatabase runs migrate:fresh.
# TESTING_PROTECTED_DATABASES=finedgerevamp

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Payment gateway queues
PAYMENTS_QUEUE_HIGH=payments-high
PAYMENTS_QUEUE=payments

# cGrate mobile money gateway (disabled by default)
CGRATE_ENABLED=false
CGRATE_BASE_URL=https://test.543.cgrate.co.zm
CGRATE_USERNAME=
CGRATE_PASSWORD=
CGRATE_TIMEOUT=30
CGRATE_CONNECT_TIMEOUT=10
CGRATE_VERIFY_SSL=true
CGRATE_AMOUNT_MODE=kwacha_decimal
CGRATE_MSISDN_FORMAT=local
CGRATE_ENDPOINT_PATH=/Konik/KonikWs
CGRATE_SOAP_NAMESPACE=http://konik.cgrate.com
CGRATE_CONTENT_TYPE="application/soap+xml; charset=utf-8"
CGRATE_POLL_INTERVAL_SECONDS=15
CGRATE_MAX_QUERY_ATTEMPTS=20
CGRATE_PAYMENT_EXPIRY_MINUTES=5
CGRATE_UNKNOWN_FAIL_AFTER_ATTEMPTS=20
CGRATE_DEFAULT_CURRENCY=ZMW
CGRATE_CALLBACK_ENABLED=false
CGRATE_CALLBACK_TOKEN=
CGRATE_CALLBACK_ALLOWED_IPS=

# UAT tooling (D1.5) — see docs/CGRATE-DISBURSEMENT-UAT.md
CGRATE_UAT_LOG_ENABLED=true
CGRATE_UAT_LOG_CHANNEL=cgrate_uat
CGRATE_UAT_LOG_DAYS=30
